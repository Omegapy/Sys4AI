  "baseline": "5736ba5847323c5d12448c578e7715b8cad31a604377088b5030bc5a44051fe9",
  "criteria": [
    {
      "criterion": "The baseline distinguishes pre-existing edits/failures, reader functionality and history; every candidate retirement caller is classified as runtime, shared helper, test, launcher, docs, distribution or historical.",
      "evidence": "Directly reopened baseline/caller index and referenced shards; captured HEAD matches source snapshot, three prior tracked dirty indexes are distinguished,15 targeted tests and48 competency cases pass, Template current. Caller classes and source imports/initializer/updater ownership are explicit. Legacy endpoint liveness is specifically unavailable due to sandbox, not falsely classified stopped."
    },
    {
      "criterion": "Each process field/order claim has exact source support or an unexamined/absent classification; no canonical content is added to fill a demonstration gap.",
      "evidence": "Inspected process field records and exact cited source sections; local precedence rules retained separately, no total sequence inferred. Absent structured fields and unexamined linked bodies are explicit; canonical mutation false."
    },
    {
      "criterion": "The local-file 347-record inventory and complete 412-record loaded inventory retain their different scopes; a canonical process identity is a lead, not evidence of ordered process steps.",
      "evidence": "Reopened seven-local-file counts347 including65bindings and imported core65 producing412 full records; full nonbinding347 separately qualified. Curator process Capability identity retained without claiming Process type or ordered steps."
    }
  ],
