{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "operation_id",
    "causal_parent",
    "kind",
    "created_at",
    "project_id",
    "repository_id",
    "coordination_root",
    "branch",
    "snapshot",
    "policy_sha256",
    "source_sha256",
    "sources",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "causal_parent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      ]
    },
    "kind": {
      "enum": [
        "accepted_work",
        "catch_up",
        "commit",
        "dependency_due",
        "manual_correction",
        "stale_product"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^[^\\u0000-\\u001f]*$",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "coordination_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "path",
          "sha256"
        ],
        "properties": {
          "owner": {
            "enum": [
              "project",
              "task",
              "memory",
              "ontology",
              "curate",
              "setup"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "manual_correction"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request"
            ],
            "properties": {
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "owner": {
                    "enum": [
                      "project",
                      "task",
                      "memory",
                      "ontology",
                      "curate",
                      "setup"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000-\\u001f]*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "commit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "accepted_work"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "completion",
              "effect"
            ],
            "properties": {
              "completion": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "owner": {
                    "enum": [
                      "task",
                      "project"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000-\\u001f]*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "effect": {
                "enum": [
                  "repair",
                  "documentation",
                  "knowledge",
                  "derivative"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "catch_up"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "previous_commit",
              "commit"
            ],
            "properties": {
              "previous_commit": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                  }
                ]
              },
              "commit": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dependency_due"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "due_at"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "due_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "^[^\\u0000-\\u001f]*$",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stale_product"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product_id",
              "owner",
              "input_sha256"
            ],
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "owner": {
                "enum": [
                  "memory",
                  "ontology"
                ]
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Immutable delivery facts, not authority. Python validation also enforces 32768 UTF-8 bytes, canonical root, relative evidence paths, explicit timezone, and no unknown fields."
}
