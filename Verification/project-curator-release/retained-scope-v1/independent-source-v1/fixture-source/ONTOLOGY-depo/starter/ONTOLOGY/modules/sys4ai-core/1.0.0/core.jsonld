        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Relationship",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A directed, typed assertion between stable endpoint identities, carrying a registered predicate, fact classification and source provenance.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Relationship",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Relationship",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:RelationshipType",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A stable predicate definition specifying allowed source and target types, qualifiers, cardinality and whether cycles are forbidden.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "RelationshipType",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:RelationshipType",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Requirement",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "An explicit expected outcome or constraint with a source and observable acceptance criterion.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Requirement",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Requirement",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Role",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A project-local function defined by a paired AGENTS.md and ROLE.md source, with capabilities, inputs, outputs, scope and stopping conditions. An index is navigation rather than role authority.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Role",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Role",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Scope",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "An explicit boundary of permitted inputs, outputs, artifacts, actions and stopping conditions.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Scope",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Scope",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Skill",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A reusable instruction and tool workflow for a bounded purpose. The Skill type, an installed skill instance and the SKILL.md artifact describing it are distinct entities.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Skill",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "scope_note": "The class Skill differs from an installed memory skill and from the SKILL.md source artifact.",
      "sources": [
        {
          "locator": "section:Skill",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Source",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "Identified evidence used to support a definition or assertion. A local source reference records exact path, SHA256 and a useful locator; changed bytes must be reported.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Source",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Source",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:SourceBinding",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A canonical connection between a semantic entity and explicitly selected current project source bytes. It never recursively imports a child project or executes a discovered skill.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "SourceBinding",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:SourceBinding",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Specification",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A governing description of required properties, constraints and interfaces. Current project specifications retain operational authority over a recalled ontology definition.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Specification",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:Specification",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:TRD",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "aliases": [
        "Task Requirement Document"
      ],
      "definition": "A Task Requirement Document capturing explicit requirements and acceptance criteria. Approval settles the requirements document; it does not activate a Task, authorize implementation or prove completion.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "TRD",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "non_examples": [
        "Task activation",
        "Implementation completion"
      ],
      "scope_note": "A requirements document is not a canonical Task or a native runtime goal.",
      "sources": [
        {
          "locator": "section:TRD",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:TRDCreation",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept",
        "urn:sys4ai:ontology:core:Capability"
      ],
      "definition": "The capability to capture requirements with the explicitly selected to-trd workflow. Creating a TRD does not create or activate a Task.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "TRDCreation",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:TRDCreation",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Task",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "aliases": [
        "Sys4AI Task"
      ],
      "definition": "A canonical Sys4AI managed work record with definition of done, execution state and confirmed owner. A Task is distinct from a TRD, implementation plan, native goal and Codex conversation. Document approval does not activate a Task or establish implementation completion.",
      "examples": [
        "A canonical task.json with a definition of done and confirmed manager"
      ],
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Task",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "non_examples": [
        "A Codex conversation",
        "An approved TRD",
        "A native goal"
      ],
      "scope_note": "Distinguish requirements approval, plan readiness, Task activation, implementation, verification and validation. These states require separate evidence.",
      "sources": [
        {
          "locator": "section:Task",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:TaskManagement",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept",
        "urn:sys4ai:ontology:core:Capability"
      ],
      "definition": "The capability to manage canonical Task execution through the current installed Task interfaces and confirmed ownership gates.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "TaskManagement",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:TaskManagement",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:TaskManager",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "A real native manager with confirmed activation, execution generation, assignment and canonical writer ownership for one Task. An ordinary child is not promoted by reading root guidance.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "TaskManager",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "sources": [
        {
          "locator": "section:TaskManager",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:TaskRequirementDocument",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "An initial-release compatibility spelling for the TRD concept. Use TRD as the preferred concept; this identity is retained and is never reassigned.",
      "deprecation_reason": "Use TRD as the preferred concept; this initial-release compatibility spelling is reserved and will never be reassigned.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "TaskRequirementDocument",
      "lifecycle": "deprecated",
      "module": "sys4ai-core",
      "replacement": "urn:sys4ai:ontology:core:TRD",
      "sources": [
        {
          "locator": "section:TaskRequirementDocument",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Validation",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "Checking that the result solves the intended problem and is fit for the intended user and use. A structural check alone is not evidence of end-to-end fitness.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Validation",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "scope_note": "Fitness for the intended use.",
      "sources": [
        {
          "locator": "section:Validation",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
    },
    {
      "@id": "urn:sys4ai:ontology:core:Verification",
      "@type": [
        "urn:sys4ai:ontology:core:OntologyConcept"
      ],
      "definition": "Checking that work conforms to the stated requirements, design and project contracts. Verification checks conformance; validation checks fitness for the intended use.",
      "fact_kind": "asserted",
      "kind": "concept",
      "label": "Verification",
      "lifecycle": "approved",
      "module": "sys4ai-core",
      "scope_note": "Conformance to the specified result.",
      "sources": [
        {
          "locator": "section:Verification",
          "path": "ONTOLOGY/modules/sys4ai-core/1.0.0/vocabulary-source.md",
          "sha256": "fbeb9c779124729c632b1489992e6f31847e3c042dbe26bc1dfd4e0032439896"
        }
      ]
