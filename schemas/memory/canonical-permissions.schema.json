{
  "$defs": {
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "approvals_required": {
          "const": 1,
          "default": 1,
          "title": "Approvals Required",
          "type": "integer"
        },
        "human_review_required": {
          "const": true,
          "default": true,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "record_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Record Types",
          "type": "array",
          "uniqueItems": true
        },
        "reviewers": {
          "items": {
            "$ref": "#/$defs/ReviewerIdentity"
          },
          "minItems": 1,
          "title": "Reviewers",
          "type": "array"
        },
        "self_approval_allowed": {
          "const": false,
          "default": false,
          "title": "Self Approval Allowed",
          "type": "boolean"
        },
        "status": {
          "const": "approved",
          "title": "Status",
          "type": "string"
        },
        "target_prefixes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Prefixes",
          "type": "array"
        }
      },
      "required": [
        "status",
        "policy_id",
        "reviewers",
        "record_types",
        "target_prefixes"
      ],
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "system",
        "workspace",
        "project",
        "agent_type",
        "agent_instance",
        "task",
        "session",
        "user"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "Permission": {
      "enum": [
        "read",
        "propose",
        "write-derived",
        "approve",
        "delete",
        "share",
        "rebuild",
        "administer"
      ],
      "title": "Permission",
      "type": "string"
    },
    "PermissionGrant": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Grant Id",
          "type": "string"
        },
        "operations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array",
          "uniqueItems": true
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "minItems": 1,
          "title": "Permissions",
          "type": "array",
          "uniqueItems": true
        },
        "principal_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeReference"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "shared_project_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Project Ids",
          "type": "array",
          "uniqueItems": true
        },
        "target_prefixes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Target Prefixes",
          "type": "array"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "grant_id",
        "principal_id",
        "permissions",
        "scopes"
      ],
      "title": "PermissionGrant",
      "type": "object"
    },
    "ReviewerIdentity": {
      "additionalProperties": false,
      "properties": {
        "higher_system_policy_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Higher System Policy Ref"
        },
        "kind": {
          "$ref": "#/$defs/ReviewerKind"
        },
        "principal_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "kind"
      ],
      "title": "ReviewerIdentity",
      "type": "object"
    },
    "ReviewerKind": {
      "enum": [
        "human",
        "system-automation"
      ],
      "title": "ReviewerKind",
      "type": "string"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/MemoryScope"
        },
        "parent_scopes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScopeReference"
          },
          "title": "Parent Scopes",
          "type": "array"
        },
        "scope_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "level",
        "scope_id"
      ],
      "title": "ScopeReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dataset_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/PermissionGrant"
      },
      "title": "Grants",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "project_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "dataset_id",
    "issued_at",
    "grants"
  ],
  "title": "CanonicalPermissionDocument",
  "type": "object"
}
