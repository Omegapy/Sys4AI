{
  "$defs": {
    "DirtyState": {
      "enum": [
        "clean",
        "dirty",
        "not_versioned",
        "unknown"
      ],
      "title": "DirtyState",
      "type": "string"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceLocatorKind"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "reference": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "EvidenceLocatorKind": {
      "enum": [
        "artifact",
        "requirement",
        "schema",
        "test",
        "validation"
      ],
      "title": "EvidenceLocatorKind",
      "type": "string"
    },
    "VersionContext": {
      "additionalProperties": false,
      "description": "Versions and fingerprints needed to interpret one operation.",
      "properties": {
        "configuration_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "configuration_version": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+~-]*$",
          "title": "Configuration Version",
          "type": "string"
        },
        "profile_fingerprints": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.:@/-]*$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1
          },
          "title": "Profile Fingerprints",
          "type": "object"
        },
        "profile_versions": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.:@/-]*$": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+~-]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1
          },
          "title": "Profile Versions",
          "type": "object"
        },
        "provider_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Fingerprint",
          "type": "string"
        },
        "provider_name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
          "title": "Provider Name",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+~-]*$",
          "title": "Provider Version",
          "type": "string"
        },
        "source_registry_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Registry Fingerprint"
        }
      },
      "required": [
        "configuration_version",
        "configuration_fingerprint",
        "provider_name",
        "provider_version",
        "provider_fingerprint"
      ],
      "title": "VersionContext",
      "type": "object"
    }
  },
  "$id": "validation-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic evidence metadata supplied after a validation command ran.",
  "properties": {
    "api_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "command": {
      "items": {
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9_./:@+=,~-][A-Za-z0-9_.:/@+=,~-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "command_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
      "title": "Command Id",
      "type": "string"
    },
    "dirty_state": {
      "$ref": "#/$defs/DirtyState"
    },
    "dirty_state_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dirty State Fingerprint"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceLocator"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "exit_status": {
      "maximum": 255,
      "minimum": 0,
      "title": "Exit Status",
      "type": "integer"
    },
    "receipt_id": {
      "pattern": "^vrc_[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "record_kind": {
      "const": "validation_receipt",
      "default": "validation_receipt",
      "title": "Record Kind",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+~-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Revision"
    },
    "versions": {
      "$ref": "#/$defs/VersionContext"
    },
    "warning_codes": {
      "default": [],
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Warning Codes",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "command_id",
    "command",
    "exit_status",
    "recorded_at",
    "source_revision",
    "dirty_state",
    "versions",
    "evidence"
  ],
  "title": "ValidationReceipt",
  "type": "object"
}
