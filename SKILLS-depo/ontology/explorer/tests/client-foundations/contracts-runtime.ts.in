  for (const r of refs) if (await sha256(coreCanonicalJson({owner_id:r.owner_id,binding_id:r.binding_id,path:r.path,locator:r.locator,recorded_sha256:r.recorded_sha256})) !== r.reference_id) return false;
  return true;
}
/** Sole network-read admission. Does not fetch, store or log the input. */
export async function decodeReadResponse(input: string | Uint8Array, expected: ResponseExpectation): Promise<Checked<ReadResponse>> {
  const checked = decodeWire('ReadResponse',input,expected.policy?.response_bytes ?? 32000);
  if (!checked.ok) return checked;
  try { if (checked.value.status === 'error' && (typeof input === 'string' ? utf8Length(input) : input.byteLength) > 1024 || !responseSemantics(checked.value,expected) || !await integrity(checked.value)) return {ok:false,error:INVALID_RESPONSE}; return checked; } catch { return {ok:false,error:INVALID_RESPONSE}; }
}
