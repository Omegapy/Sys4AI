/** Core canonical_bytes differs from compact cursor/scope serialization. */
export function coreCanonicalJson(v: unknown): string {
  const sorted = (x: unknown): unknown => Array.isArray(x) ? x.map(sorted) : plainObject(x) ? Object.fromEntries(Object.keys(x).sort().map(k=>[k,sorted(x[k])])) : x;
  return JSON.stringify(sorted(v), null, 2) + '\n';
}
async function sha256(s: string): Promise<string> { const bytes = encoder.encode(s); const digest = await globalThis.crypto.subtle.digest('SHA-256',bytes); return Array.from(new Uint8Array(digest), b=>b.toString(16).padStart(2,'0')).join(''); }
async function integrity(r: ReadResponse): Promise<boolean> {
