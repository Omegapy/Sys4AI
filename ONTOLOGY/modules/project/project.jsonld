    {
      "@id": "urn:sys4ai:ontology:project:sys4ai-depot:capability-project-knowledge-explorer",
      "@type": [
        "urn:sys4ai:ontology:core:Capability"
      ],
      "aliases": [
        "Knowledge Explorer",
        "read-only ontology browser"
      ],
      "definition": "A read-only loopback browser exposes Overview, Terms, Processes, and Map for one selected project root. It reads canonical knowledge and permitted sources without authoring or execution authority. Its reading session has no automatic time limit: Close reading session revokes it, and service stop or package replacement invalidates it.",
      "fact_kind": "asserted",
      "kind": "instance",
      "label": "Project Knowledge Explorer",
      "lifecycle": "approved",
      "module": "project",
      "scope_note": "Closing a browser tab alone does not revoke the server session. Bootstrap links and pagination cursors retain bounded lifetimes. Core reads use Python 3.12 and packaged assets without activating optional profiles. Initializer governance-starter-v13 installs static capability without starting a service; the neutral Template does not inherit depot identity, and existing projects need scoped adoption. Recorded capability does not certify complete release verification.",
      "sources": [
        {
          "locator": "section:Project Knowledge Explorer and initialization v13",
          "path": "SPECS.md",
          "sha256": "0b70e312ab29785f4d003b4ea4dc7b920a239c6b1a5cceeec69a173f12a96bf6"
        },
        {
          "locator": "section:Ontology",
