{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sys4ai:ontology:schema:proposal-v1",
  "title": "Immutable ontology candidate revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "project_id", "revision", "parent_sha256", "created_at", "candidate", "candidate_sha256", "base_context", "rationale", "evidence", "uncertainty", "generator", "source_packet", "addressed_findings", "semantic_diff", "revision_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^ONTPROP-[A-Za-z0-9-]{4,100}$"},
    "project_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "parent_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "created_at": {"type": "string"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "candidate_sha256": {"$ref": "#/$defs/digest"},
    "base_context": {"type": "object"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/source"}},
    "uncertainty": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "generator": {"type": ["object", "null"]},
    "source_packet": {"type": ["object", "null"]},
    "addressed_findings": {"type": "array", "items": {"type": "string"}},
    "semantic_diff": {"type": "array", "items": {"type": "object"}},
    "revision_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}, "locator": {"type": "string", "minLength": 1, "maxLength": 300}}},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation_id", "operation", "reason", "changes"],
      "properties": {
        "schema_version": {"enum": [1, 2]}, "operation_id": {"type": "string", "pattern": "^ONTOP-[A-Za-z0-9-]{4,100}$"},
        "operation": {"const": "publish"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "changes": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "additionalProperties": false,
          "required": ["path", "expected_sha256", "content", "sha256"], "properties": {
            "path": {"type": "string"}, "expected_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
            "content": {"type": "string", "maxLength": 250000}, "sha256": {"$ref": "#/$defs/digest"}
          }}}
      }
    }
  }
}
