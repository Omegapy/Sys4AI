{
  "$defs": {
    "CogneeSettings": {
      "additionalProperties": false,
      "properties": {
        "accept_local_file_path": {
          "title": "Accept Local File Path",
          "type": "boolean"
        },
        "backend_access_control_posture": {
          "title": "Backend Access Control Posture",
          "type": "string"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "backend_access_control_posture",
        "accept_local_file_path"
      ],
      "title": "CogneeSettings",
      "type": "object"
    },
    "ControlRecordSettings": {
      "additionalProperties": false,
      "properties": {
        "approval_policy_status": {
          "title": "Approval Policy Status",
          "type": "string"
        },
        "approvals_required": {
          "const": 1,
          "title": "Approvals Required",
          "type": "integer"
        },
        "deny_unresolved_approval": {
          "title": "Deny Unresolved Approval",
          "type": "boolean"
        },
        "reviewer_principal_id": {
          "title": "Reviewer Principal Id",
          "type": "string"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "self_approval_allowed": {
          "const": false,
          "title": "Self Approval Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "root",
        "approval_policy_status",
        "reviewer_principal_id",
        "approvals_required",
        "self_approval_allowed",
        "deny_unresolved_approval"
      ],
      "title": "ControlRecordSettings",
      "type": "object"
    },
    "ExactIndexSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "provider",
        "path"
      ],
      "title": "ExactIndexSettings",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "const": "zip",
          "title": "Container",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "encryption": {
          "const": "age-x25519",
          "title": "Encryption",
          "type": "string"
        },
        "encryption_required": {
          "title": "Encryption Required",
          "type": "boolean"
        },
        "format_status": {
          "title": "Format Status",
          "type": "string"
        },
        "provider_native_export_enabled": {
          "title": "Provider Native Export Enabled",
          "type": "boolean"
        },
        "recipient_reference_required": {
          "title": "Recipient Reference Required",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "format_status",
        "container",
        "encryption_required",
        "encryption",
        "recipient_reference_required",
        "provider_native_export_enabled"
      ],
      "title": "ExportSettings",
      "type": "object"
    },
    "FeedbackSettings": {
      "additionalProperties": false,
      "properties": {
        "automatic_collection": {
          "title": "Automatic Collection",
          "type": "boolean"
        },
        "explicit_typed_only": {
          "title": "Explicit Typed Only",
          "type": "boolean"
        },
        "policy_status": {
          "title": "Policy Status",
          "type": "string"
        }
      },
      "required": [
        "automatic_collection",
        "explicit_typed_only",
        "policy_status"
      ],
      "title": "FeedbackSettings",
      "type": "object"
    },
    "MemorySettings": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1.0",
          "title": "Api Version",
          "type": "string"
        },
        "control_records": {
          "$ref": "#/$defs/ControlRecordSettings"
        },
        "default_memory_profile": {
          "title": "Default Memory Profile",
          "type": "string"
        },
        "deployment_profile": {
          "title": "Deployment Profile",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "exact_index": {
          "$ref": "#/$defs/ExactIndexSettings"
        },
        "export": {
          "$ref": "#/$defs/ExportSettings"
        },
        "feedback": {
          "$ref": "#/$defs/FeedbackSettings"
        },
        "local_data_dir": {
          "title": "Local Data Dir",
          "type": "string"
        },
        "models": {
          "$ref": "#/$defs/ModelSettings"
        },
        "observability": {
          "$ref": "#/$defs/ObservabilitySettings"
        },
        "permissions": {
          "$ref": "#/$defs/PermissionSettings"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        },
        "registries": {
          "$ref": "#/$defs/RegistrySettings"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSettings"
        },
        "security": {
          "$ref": "#/$defs/SecuritySettings"
        },
        "service": {
          "$ref": "#/$defs/ServiceSettings"
        },
        "shared": {
          "$ref": "#/$defs/SharedSettings"
        },
        "sources": {
          "$ref": "#/$defs/SourceSettings"
        },
        "strict_config": {
          "title": "Strict Config",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "api_version",
        "project_id",
        "project_root",
        "default_memory_profile",
        "deployment_profile",
        "local_data_dir",
        "read_only",
        "strict_config",
        "service",
        "provider",
        "exact_index",
        "models",
        "registries",
        "sources",
        "control_records",
        "permissions",
        "security",
        "retention",
        "export",
        "shared",
        "feedback",
        "observability"
      ],
      "title": "MemorySettings",
      "type": "object"
    },
    "ModelRuntimeProfile": {
      "additionalProperties": false,
      "description": "Named local or remote model endpoint with references, never secret values.",
      "properties": {
        "capability": {
          "enum": [
            "llm",
            "embedding"
          ],
          "title": "Capability",
          "type": "string"
        },
        "credential_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Reference"
        },
        "dimensions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "locality": {
          "enum": [
            "local",
            "remote"
          ],
          "title": "Locality",
          "type": "string"
        },
        "model": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "capability",
        "locality",
        "provider",
        "model"
      ],
      "title": "ModelRuntimeProfile",
      "type": "object"
    },
    "ModelSettings": {
      "additionalProperties": false,
      "properties": {
        "allow_cloud_fallback": {
          "title": "Allow Cloud Fallback",
          "type": "boolean"
        },
        "allow_remote": {
          "title": "Allow Remote",
          "type": "boolean"
        },
        "embedding_profile": {
          "title": "Embedding Profile",
          "type": "string"
        },
        "llm_profile": {
          "title": "Llm Profile",
          "type": "string"
        },
        "model_cache_dir": {
          "title": "Model Cache Dir",
          "type": "string"
        },
        "profiles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelRuntimeProfile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "semantic_enabled": {
          "title": "Semantic Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "semantic_enabled",
        "llm_profile",
        "embedding_profile",
        "model_cache_dir",
        "allow_remote",
        "allow_cloud_fallback"
      ],
      "title": "ModelSettings",
      "type": "object"
    },
    "ObservabilitySettings": {
      "additionalProperties": false,
      "properties": {
        "content_logging": {
          "enum": [
            "metadata_only",
            "disabled"
          ],
          "title": "Content Logging",
          "type": "string"
        },
        "local_audit_log": {
          "title": "Local Audit Log",
          "type": "string"
        },
        "telemetry_export": {
          "title": "Telemetry Export",
          "type": "boolean"
        }
      },
      "required": [
        "local_audit_log",
        "content_logging",
        "telemetry_export"
      ],
      "title": "ObservabilitySettings",
      "type": "object"
    },
    "PermissionSettings": {
      "additionalProperties": false,
      "properties": {
        "general_operations": {
          "items": {
            "type": "string"
          },
          "title": "General Operations",
          "type": "array"
        },
        "mutation_enabled": {
          "title": "Mutation Enabled",
          "type": "boolean"
        },
        "privileged_operations": {
          "items": {
            "type": "string"
          },
          "title": "Privileged Operations",
          "type": "array"
        },
        "require_canonical_permission": {
          "title": "Require Canonical Permission",
          "type": "boolean"
        }
      },
      "required": [
        "general_operations",
        "privileged_operations",
        "mutation_enabled",
        "require_canonical_permission"
      ],
      "title": "PermissionSettings",
      "type": "object"
    },
    "ProviderSettings": {
      "additionalProperties": false,
      "properties": {
        "allow_native_client_access": {
          "title": "Allow Native Client Access",
          "type": "boolean"
        },
        "cognee": {
          "$ref": "#/$defs/CogneeSettings"
        },
        "initialize_on_load": {
          "title": "Initialize On Load",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "standalone",
            "api",
            "cloud"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outbound_network": {
          "enum": [
            "deny",
            "local-only",
            "allow"
          ],
          "title": "Outbound Network",
          "type": "string"
        },
        "version_constraint": {
          "title": "Version Constraint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version_constraint",
        "mode",
        "initialize_on_load",
        "allow_native_client_access",
        "outbound_network",
        "cognee"
      ],
      "title": "ProviderSettings",
      "type": "object"
    },
    "RegistrySettings": {
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "title": "Profiles",
          "type": "string"
        },
        "relations": {
          "title": "Relations",
          "type": "string"
        },
        "sources": {
          "title": "Sources",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "profiles",
        "relations"
      ],
      "title": "RegistrySettings",
      "type": "object"
    },
    "RetentionSettings": {
      "additionalProperties": false,
      "properties": {
        "episodic_persistence": {
          "title": "Episodic Persistence",
          "type": "boolean"
        },
        "episodic_ttl_days": {
          "exclusiveMinimum": 0,
          "title": "Episodic Ttl Days",
          "type": "integer"
        },
        "policy_status": {
          "title": "Policy Status",
          "type": "string"
        },
        "session_persistence": {
          "title": "Session Persistence",
          "type": "boolean"
        },
        "session_ttl_hours": {
          "exclusiveMinimum": 0,
          "title": "Session Ttl Hours",
          "type": "integer"
        }
      },
      "required": [
        "policy_status",
        "session_ttl_hours",
        "episodic_ttl_days",
        "session_persistence",
        "episodic_persistence"
      ],
      "title": "RetentionSettings",
      "type": "object"
    },
    "SecuritySettings": {
      "additionalProperties": false,
      "properties": {
        "allow_arbitrary_local_paths": {
          "title": "Allow Arbitrary Local Paths",
          "type": "boolean"
        },
        "allow_authority_inheritance": {
          "title": "Allow Authority Inheritance",
          "type": "boolean"
        },
        "destructive_execution_enabled": {
          "title": "Destructive Execution Enabled",
          "type": "boolean"
        },
        "external_content_is_authority": {
          "title": "External Content Is Authority",
          "type": "boolean"
        },
        "require_dry_run_for_destructive": {
          "title": "Require Dry Run For Destructive",
          "type": "boolean"
        },
        "require_impact_preview": {
          "title": "Require Impact Preview",
          "type": "boolean"
        },
        "safe_path_mode": {
          "const": "project-allowlist",
          "title": "Safe Path Mode",
          "type": "string"
        },
        "secret_scan": {
          "title": "Secret Scan",
          "type": "boolean"
        }
      },
      "required": [
        "secret_scan",
        "external_content_is_authority",
        "allow_authority_inheritance",
        "safe_path_mode",
        "allow_arbitrary_local_paths",
        "require_dry_run_for_destructive",
        "require_impact_preview",
        "destructive_execution_enabled"
      ],
      "title": "SecuritySettings",
      "type": "object"
    },
    "ServiceSettings": {
      "additionalProperties": false,
      "properties": {
        "authentication_posture": {
          "title": "Authentication Posture",
          "type": "string"
        },
        "bind_host": {
          "title": "Bind Host",
          "type": "string"
        },
        "network_listener_enabled": {
          "title": "Network Listener Enabled",
          "type": "boolean"
        },
        "single_writer": {
          "title": "Single Writer",
          "type": "boolean"
        },
        "transport": {
          "enum": [
            "in_process",
            "http",
            "mcp"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "network_listener_enabled",
        "bind_host",
        "authentication_posture",
        "single_writer"
      ],
      "title": "ServiceSettings",
      "type": "object"
    },
    "SharedSettings": {
      "additionalProperties": false,
      "properties": {
        "authentication_required": {
          "title": "Authentication Required",
          "type": "boolean"
        },
        "backend_status": {
          "title": "Backend Status",
          "type": "string"
        },
        "dataset_isolation_required": {
          "title": "Dataset Isolation Required",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "backend_status",
        "authentication_required",
        "dataset_isolation_required"
      ],
      "title": "SharedSettings",
      "type": "object"
