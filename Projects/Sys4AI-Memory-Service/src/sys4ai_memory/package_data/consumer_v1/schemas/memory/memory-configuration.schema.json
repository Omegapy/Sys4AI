        },
        "require_discovery_dry_run": {
          "title": "Require Discovery Dry Run",
          "type": "boolean"
        },
        "require_registered_rule": {
          "title": "Require Registered Rule",
          "type": "boolean"
        },
        "respect_gitignore": {
          "title": "Respect Gitignore",
          "type": "boolean"
        }
