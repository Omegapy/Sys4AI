      "required": [
        "respect_gitignore",
        "default_include",
        "require_registered_rule",
        "require_discovery_dry_run"
      ],
      "title": "SourceSettings",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "const": "1.0",
      "title": "Config Version",
      "type": "string"
    },
    "configuration_status": {
      "title": "Configuration Status",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/MemorySettings"
    }
  },
  "required": [
    "config_version",
    "configuration_status",
    "memory"
  ],
  "title": "MemoryConfiguration",
  "type": "object"
}
