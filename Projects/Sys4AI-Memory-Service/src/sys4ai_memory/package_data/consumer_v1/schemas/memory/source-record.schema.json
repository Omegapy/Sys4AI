{
  "$defs": {
    "AuthorityTier": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7"
      ],
      "title": "AuthorityTier",
      "type": "string"
    },
    "JsonValue": {},
    "MemoryScope": {
      "enum": [
        "system",
        "workspace",
        "project",
        "agent_type",
        "agent_instance",
        "task",
        "session",
        "user"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/MemoryScope"
        },
        "parent_scopes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScopeReference"
          },
          "title": "Parent Scopes",
          "type": "array"
        },
        "scope_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "level",
        "scope_id"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret-prohibited"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SourceRole": {
      "enum": [
        "authoritative",
        "evidential",
        "generated",
        "episodic",
        "scratch"
      ],
      "title": "SourceRole",
      "type": "string"
    },
    "TrustClass": {
      "enum": [
        "system-controlled",
        "human-approved",
        "schema-validated",
        "project-authored",
        "externally-authenticated",
        "external-unverified",
        "agent-generated",
        "model-extracted",
        "user-supplied",
        "untrusted"
      ],
      "title": "TrustClass",
      "type": "string"
    }
  },
  "$id": "source-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable source metadata from PRD 13.2 and MEM-FR-019 through 028.",
  "properties": {
    "access_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Access Metadata",
      "type": "object"
    },
    "api_version": {
      "const": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "authority_tier": {
      "$ref": "#/$defs/AuthorityTier"
    },
    "canonicality": {
      "minLength": 1,
      "title": "Canonicality",
      "type": "string"
    },
    "chunking_profile": {
      "minLength": 1,
      "title": "Chunking Profile",
      "type": "string"
    },
    "content_role": {
      "$ref": "#/$defs/SourceRole"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Sha256"
    },
    "format": {
      "minLength": 1,
      "title": "Format",
      "type": "string"
    },
    "generated_from": {
      "items": {
        "maxLength": 255,
        "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
        "type": "string"
      },
      "title": "Generated From",
      "type": "array"
    },
    "git_blob_sha": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Git Blob Sha"
    },
    "git_commit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Git Commit"
    },
    "include_flag": {
      "title": "Include Flag",
      "type": "boolean"
    },
    "ingestion_adapter": {
      "minLength": 1,
      "title": "Ingestion Adapter",
      "type": "string"
    },
    "licensing_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Licensing Metadata",
      "type": "object"
    },
    "locator": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Locator",
      "type": "object"
    },
    "namespace": {
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notes"
    },
    "origin_uri": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Origin Uri"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "path_or_uri": {
      "minLength": 1,
      "title": "Path Or Uri",
      "type": "string"
    },
    "path_pattern": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Path Pattern"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "refresh_mode": {
      "minLength": 1,
      "title": "Refresh Mode",
      "type": "string"
    },
    "retention_policy": {
      "minLength": 1,
      "title": "Retention Policy",
      "type": "string"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieved At"
    },
    "schema_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schema Ref"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeReference"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_id": {
      "maxLength": 255,
      "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "minLength": 1,
      "title": "Source Kind",
      "type": "string"
    },
    "trust_class": {
      "$ref": "#/$defs/TrustClass"
    },
    "working_tree_state": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Working Tree State"
    },
    "write_policy": {
      "minLength": 1,
      "title": "Write Policy",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "api_version",
    "source_id",
    "project_id",
    "path_or_uri",
    "path_pattern",
    "source_kind",
    "format",
    "canonicality",
    "content_role",
    "authority_tier",
    "trust_class",
    "sensitivity",
    "namespace",
    "scope",
    "profile_id",
    "ingestion_adapter",
    "chunking_profile",
    "schema_ref",
    "refresh_mode",
    "retention_policy",
    "owner",
    "write_policy",
    "include_flag",
    "notes",
    "content_sha256",
    "locator",
    "git_commit",
    "git_blob_sha",
    "working_tree_state",
    "origin_uri",
    "retrieved_at",
    "licensing_metadata",
    "access_metadata",
    "generated_from"
  ],
  "title": "SourceRecord",
  "type": "object",
  "x-sys4ai-schema-version": "1.0"
}
