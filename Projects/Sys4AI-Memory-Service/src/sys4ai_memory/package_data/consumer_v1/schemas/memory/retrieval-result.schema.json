{
  "$defs": {
    "AuthorityTier": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7"
      ],
      "title": "AuthorityTier",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "sufficient",
        "insufficient"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "JsonValue": {},
    "RecordStatus": {
      "enum": [
        "proposed",
        "staged",
        "approved",
        "active",
        "superseded",
        "rejected",
        "invalidated",
        "expired",
        "withdrawn",
        "deleted"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "RetrievalAuthority": {
      "additionalProperties": false,
      "properties": {
        "tier": {
          "$ref": "#/$defs/AuthorityTier"
        },
        "trust_class": {
          "$ref": "#/$defs/TrustClass"
        }
      },
      "required": [
        "tier",
        "trust_class"
      ],
      "title": "RetrievalAuthority",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "title": "Current Only",
          "type": "boolean"
        },
        "namespaces": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Namespaces",
          "type": "array"
        },
        "omitted_result_count": {
          "default": 0,
          "minimum": 0,
          "title": "Omitted Result Count",
          "type": "integer"
        },
        "permission": {
          "title": "Permission",
          "type": "boolean"
        },
        "project_scope": {
          "title": "Project Scope",
          "type": "boolean"
        },
        "status_filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordStatus"
          },
          "title": "Status Filters",
          "type": "array"
        },
        "time_constraints": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Time Constraints",
          "type": "object"
        },
        "trust_minimum": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrustClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_scope",
        "permission",
        "current_only",
        "trust_minimum"
      ],
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalLifecycle": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/RecordStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "RetrievalLifecycle",
      "type": "object"
    },
    "RetrievalMode": {
      "enum": [
        "exact",
        "lexical",
        "semantic",
        "graph",
        "temporal",
        "hybrid"
      ],
      "title": "RetrievalMode",
      "type": "string"
    },
    "RetrievalScores": {
      "additionalProperties": false,
      "properties": {
        "authority_boost": {
          "title": "Authority Boost",
          "type": "number"
        },
        "duplicate_penalty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Penalty"
        },
        "exact": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Exact",
          "type": "number"
        },
        "final": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final",
          "type": "number"
        },
        "freshness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness"
        },
        "graph": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Graph",
          "type": "number"
        },
        "lexical": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lexical",
          "type": "number"
        },
        "scope_distance_penalty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Distance Penalty"
        },
        "semantic": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic",
          "type": "number"
        },
        "superseded_penalty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded Penalty"
        },
        "temporal": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal"
        },
        "trust": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust"
        },
        "unverified_penalty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unverified Penalty"
        }
      },
      "required": [
        "exact",
        "lexical",
        "semantic",
        "graph",
        "authority_boost",
        "final"
      ],
      "title": "RetrievalScores",
      "type": "object"
    },
    "RetrievalSource": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "git_commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "origin_uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Uri"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "locator"
      ],
      "title": "RetrievalSource",
      "type": "object"
    },
    "RetrievedRecord": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/RetrievalAuthority"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/RetrievalLifecycle"
        },
        "record_id": {
          "maxLength": 255,
          "pattern": "^mem_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Za-z0-9_]*$",
          "title": "Record Type",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/RetrievalScores"
        },
        "selection_reason": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Selection Reason",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/RetrievalSource"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_type",
        "title",
        "content",
        "source",
        "authority",
        "lifecycle",
        "scores",
        "selection_reason"
      ],
      "title": "RetrievedRecord",
      "type": "object"
    },
    "TrustClass": {
      "enum": [
        "system-controlled",
        "human-approved",
        "schema-validated",
        "project-authored",
        "externally-authenticated",
        "external-unverified",
        "agent-generated",
        "model-extracted",
        "user-supplied",
        "untrusted"
      ],
      "title": "TrustClass",
      "type": "string"
    }
  },
  "$id": "retrieval-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "evidence_state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "filters_applied": {
      "$ref": "#/$defs/RetrievalFilters"
    },
    "mode": {
      "$ref": "#/$defs/RetrievalMode"
    },
    "project_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "request_id": {
      "maxLength": 255,
      "pattern": "^mrq_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/RetrievedRecord"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 255,
      "pattern": "^trace_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "api_version",
    "request_id",
    "project_id",
    "query",
    "mode",
    "evidence_state",
    "results",
    "filters_applied",
    "trace_id"
  ],
  "title": "RetrievalResult",
  "type": "object",
  "x-sys4ai-schema-version": "1.0"
}
