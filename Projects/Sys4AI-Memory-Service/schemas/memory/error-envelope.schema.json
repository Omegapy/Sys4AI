{
  "$defs": {
    "ErrorCategory": {
      "enum": [
        "MEMORY_NOT_INITIALIZED",
        "PROJECT_NOT_FOUND",
        "SOURCE_NOT_REGISTERED",
        "SOURCE_EXCLUDED",
        "SCHEMA_INVALID",
        "PROFILE_INCOMPATIBLE",
        "PERMISSION_DENIED",
        "AUTHORITY_VIOLATION",
        "SENSITIVITY_VIOLATION",
        "PROVIDER_UNAVAILABLE",
        "PROVIDER_UNSUPPORTED",
        "INDEX_DRIFT",
        "INGESTION_FAILED",
        "RETRIEVAL_FAILED",
        "INSUFFICIENT_EVIDENCE",
        "WRITE_REJECTED",
        "APPROVAL_REQUIRED",
        "CONFLICT_DETECTED",
        "DELETION_RESTRICTED",
        "REBUILD_FAILED",
        "IMPORT_INVALID",
        "EXPORT_FAILED",
        "CONCURRENT_OPERATION"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "title": "Recoverable",
          "type": "boolean"
        },
        "remediation_hint": {
          "minLength": 1,
          "title": "Remediation Hint",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 255,
          "pattern": "^trace_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "category",
        "message",
        "trace_id",
        "recoverable",
        "remediation_hint"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "$id": "error-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "api_version",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object",
  "x-sys4ai-schema-version": "1.0"
}
