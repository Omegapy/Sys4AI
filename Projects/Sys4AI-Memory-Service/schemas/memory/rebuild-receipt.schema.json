{
  "$defs": {
    "RebuildSourceRevision": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "source_id": {
          "maxLength": 255,
          "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "content_sha256"
      ],
      "title": "RebuildSourceRevision",
      "type": "object"
    }
  },
  "$id": "rebuild-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Rebuild receipt fields required by MEM-FR-124.",
  "properties": {
    "adapter_versions": {
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_.:@/-]*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 255,
        "minLength": 1
      },
      "title": "Adapter Versions",
      "type": "object"
    },
    "api_version": {
      "const": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "configuration_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Fingerprint",
      "type": "string"
    },
    "model_identifiers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Identifiers",
      "type": "array"
    },
    "outcome": {
      "minLength": 1,
      "title": "Outcome",
      "type": "string"
    },
    "profile_versions": {
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_.:@/-]*$": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 255,
        "minLength": 1
      },
      "title": "Profile Versions",
      "type": "object"
    },
    "project_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:@/-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 255,
      "pattern": "^rbr_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revisions": {
      "items": {
        "$ref": "#/$defs/RebuildSourceRevision"
      },
      "title": "Source Revisions",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 255,
      "pattern": "^trace_[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
      "title": "Trace Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "api_version",
    "receipt_id",
    "project_id",
    "source_revisions",
    "configuration_fingerprint",
    "profile_versions",
    "adapter_versions",
    "provider_version",
    "model_identifiers",
    "started_at",
    "completed_at",
    "warnings",
    "outcome",
    "trace_id"
  ],
  "title": "RebuildReceipt",
  "type": "object",
  "x-sys4ai-schema-version": "1.0"
}
