# ============================================================
# Visual Studio Code
# ============================================================

# Do not ignore the entire .vscode directory by default.
# Files such as settings.json, tasks.json, launch.json, and
# extensions.json can contain useful project configuration.
#
# Uncomment if you intentionally want ALL VS Code settings local:
#
# .vscode/

# Common machine-specific VS Code files
.vscode/*.log


# ============================================================
# JetBrains / PyCharm
# ============================================================

# Do not automatically ignore the entire .idea directory if
# you intend to share useful project configuration.
#
# Uncomment if you want all JetBrains project settings local:
#
# .idea/

# Common machine/user-specific JetBrains files
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries/
.idea/**/shelf/


