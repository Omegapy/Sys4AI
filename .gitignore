# ============================================================
# Repo-local ignores
# ============================================================

Step-by-step-Comments/

# Generated skill-package exports; source directories remain tracked.
/SKILLS-depo/*.zip


# ============================================================
# Sys4AI project tracking boundary
# ============================================================

# Track the Template and the container guide.
# All other project working trees remain excluded.
/Projects/*
!/Projects/README.md
!/Projects/Sys4AI-Template-Project/


# ============================================================
# Task runtime state
# ============================================================

# Durable Task records and Tasks/INDEX.md remain tracked. Locks and transaction
# temporaries are local runtime state.
/Tasks/.locks/
/Tasks/.tmp/


