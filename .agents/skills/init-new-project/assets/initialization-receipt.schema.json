{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sys4AI project initialization receipt",
  "type": "object",
  "required": ["schema_version", "status", "mode", "identity", "project_root", "artifact_receipt", "artifact_sha256", "sources", "owned_files", "completed_stages", "active_stage", "checks", "semantic_provider_status", "models_status", "git_setup"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["partial", "prepared", "completed"]},
    "mode": {"enum": ["create", "prepare-existing"]},
    "identity": {
      "type": "object",
      "required": ["project_id", "project_name", "purpose", "relative_path", "principal_id", "dataset_id"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "project_name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "pattern": "^Projects/"},
        "principal_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "pattern": "-memory$"}
      }
    },
    "project_root": {"type": "string", "pattern": "^/"},
    "artifact_receipt": {"type": "string", "pattern": "^/"},
    "artifact_sha256": {"$ref": "#/$defs/sha"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "destination", "source_sha256", "destination_sha256", "source_version"], "properties": {"source_sha256": {"$ref": "#/$defs/sha"}, "destination_sha256": {"$ref": "#/$defs/sha"}}}},
    "owned_files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}},
    "completed_stages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "active_stage": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["check", "outcome"]}},
    "semantic_provider_status": {"const": "deferred"},
    "models_status": {"const": "deferred"},
    "git_setup": {"const": "separate"},
    "runtime": {"type": "object", "required": ["version", "wheel_sha256", "environment", "observed"]},
    "next_command": {"type": "array", "items": {"type": "string"}},
    "recovery": {"type": "object", "required": ["stage", "completed_stages", "owned_record", "next_action"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"required": ["runtime", "registry", "preparation", "initialization", "functional_memory", "installed_package_files"]}},
    {"if": {"properties": {"status": {"const": "prepared"}}}, "then": {"required": ["runtime", "registry", "preparation", "next_command", "installed_package_files"]}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
