{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sys4AI governance starter setup receipt",
  "type": "object",
  "required": [
    "schema_version",
    "setup_contract",
    "status",
    "mode",
    "operation_id",
    "identity",
    "project_root",
    "sources",
    "owned_files",
    "preserved_files",
    "completed_stages",
    "active_stage",
    "checks",
    "created_at",
    "git_setup"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "setup_contract": {
      "enum": [
        "governance-starter-v1",
        "governance-starter-v2",
        "governance-starter-v3",
        "governance-starter-v4"
      ]
    },
    "status": {
      "enum": [
        "partial",
        "completed"
      ]
    },
    "mode": {
      "enum": [
        "create",
        "prepare-existing"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^project-setup-[0-9a-f]{32}$"
    },
    "identity": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "project_name",
        "purpose",
        "relative_path"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "pattern": "^Projects/"
        }
      }
    },
    "project_root": {
      "type": "string",
      "pattern": "^/"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination",
          "source_sha256",
          "destination_sha256",
          "source_version",
          "adoption"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^Projects/Sys4AI-Template-Project/"
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "$ref": "#/$defs/sha"
          },
          "destination_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_version": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "adoption": {
            "enum": [
              "adopted",
              "preserved-project-owned",
              "skipped-existing-package",
              "skipped-existing-license"
            ]
          }
        }
      }
    },
    "owned_files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha"
      }
    },
    "preserved_files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha"
      }
    },
    "preserved_licenses": {
      "description": "Original project-owned license markers and tree hashes for v4. An empty map records adoption of the Template license trio.",
      "$ref": "#/$defs/licenseInventory"
    },
    "current_licenses": {
      "description": "License marker paths and hashes observed during the latest v4 verification; original preservation evidence remains unchanged.",
      "$ref": "#/$defs/licenseInventory"
    },
    "current_files": {
      "type": "object",
      "description": "Hashes observed at exact current paths. A v2 receipt after a proven case rename uses Roles paths here while its original source and adoption maps retain roles paths.",
      "additionalProperties": {
        "$ref": "#/$defs/sha"
      }
    },
    "role_case_transition": {
      "type": "object",
      "required": ["path", "sha256", "source", "destination"],
      "additionalProperties": false,
      "properties": {
        "path": {"const": ".sys4ai/roles-case-rename.json"},
        "sha256": {"$ref": "#/$defs/sha"},
        "source": {"const": "roles"},
        "destination": {"const": "Roles"}
      }
    },
    "recovery_before": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/sha"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "completed_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "assets",
          "registration",
          "verification"
        ]
      }
    },
    "active_stage": {
      "enum": [
        "assets",
        "registration",
        "verification",
        null
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "outcome"
        ],
        "properties": {
          "check": {
            "enum": [
              "project-identity",
              "project-files",
              "registration"
            ]
          },
          "outcome": {
            "const": "passed"
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "git_setup": {
      "const": "separate"
    },
    "registry": {
      "type": "object",
      "required": [
        "entry",
        "changed",
        "sha256"
      ],
      "properties": {
        "entry": {
          "type": "object"
        },
        "changed": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"setup_contract": {"const": "governance-starter-v4"}}},
      "then": {
        "required": ["preserved_licenses"],
        "allOf": [{
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {"required": ["current_licenses"]}
        }]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "registry",
          "current_files",
          "verified_at"
        ],
        "properties": {
          "active_stage": {
            "type": "null"
          },
          "completed_stages": {
            "const": [
              "assets",
              "registration",
              "verification"
            ]
          },
          "checks": {
            "const": [
              {
                "check": "project-identity",
                "outcome": "passed"
              },
              {
                "check": "project-files",
                "outcome": "passed"
              },
              {
                "check": "registration",
                "outcome": "passed"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "licenseInventory": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{"$ref": "#/$defs/sha"}, {"const": "directory"}]
      }
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
